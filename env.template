# The variables the bot needs. Placeholders only - safe to commit.
#
# CLOUD ROUTINES: paste these (with real values) into the cloud environment's
#   "Environment variables" box. That is the ONLY place routines read keys from;
#   scripts never read .env in the cloud (CLAUDE_CODE_REMOTE=true).
# LOCAL TESTING: copy to .env (gitignored). Real env vars always override .env.

# --- Alpaca (paper) ---
ALPACA_API_KEY=your-paper-key-id
ALPACA_SECRET_KEY=your-paper-secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
PAPER_TRADING=true
# Live trading requires BOTH PAPER_TRADING=false AND LIVE_CONFIRM=yes
LIVE_CONFIRM=no

# --- Perplexity (research) ---
PERPLEXITY_API_KEY=your-perplexity-key
PERPLEXITY_MODEL=sonar

# --- WhatsApp notifications ---
# callmebot | twilio | console
WHATSAPP_BACKEND=callmebot
# CallMeBot: phone in international format, e.g. +15551234567
CALLMEBOT_PHONE=+10000000000
CALLMEBOT_APIKEY=your-callmebot-apikey
# Twilio (only if WHATSAPP_BACKEND=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+10000000000
